# ${                          |
#   ${(%):-                   |
#      %(2~                   | if at least two (named) directory parts
#          |%F{39}            | then, color bright blue
#           %(5~              |   if at lest five (named) directory parts
#               |%-1~         |   then, display first part
#                %F{31}       |         color blue
#                /…/          |         separator section
#                %3~          |         last three parts
#               |%4~          |   else, use the whole path
#           )                 |
#          |                  | else, do nothing
#      )                      |
#   }%/*                      | remove last part of the path
# }                           |
# ${(%):-                     |
#     %(2~                    | if at least two (named) directory parts
#         |/                  | then, add a /
#         |                   | else, don't
#     )                       |
# }                           |
# ${(%):-                     |
#     %F{39}                  | color bright blue
#     %1~                     | display last part of path
#     %f                      | reset foreground
# }                           |
