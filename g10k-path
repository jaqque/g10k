# new plan - nested $(~||)!
REPLY=' %(5~|%-1~/…/%3~|%4~) '

# end result:
#   0  segments) highlighted
#   1  segment)  highlighted
#   2  segments) highlighted
#   3+ segments) first & last segments highlighted, rest lowlighted
#   use paramter expansion to peel off last segment

local _hi_segment='%B%F{39}'
local _lo_segment='%b%F{31}'
local _path='%(5~,%-1~/…/%3~,%~)'
local _first_segment="${(%):-%(2~,%-1~,)}"
local _last_segment="${(%):-%1~}"
REPLY=\
"${(%):-$_hi_segment$_first_segment$_lo_segment}"\
"${${${(%):-$_path}#$_first_segment}%$_last_segment}"\
"${(%):-$_hi_segment$_last_segment%f%b}"\
" "

