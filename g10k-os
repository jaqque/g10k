case $(uname) in
  SunOS)                     REPLY=$icons[SUNOS_ICON];;
  Darwin)                    REPLY=$icons[APPLE_ICON];;
  CYGWIN*|MSYS*|MINGW*)      REPLY=$icons[WINDOWS_ICON];;
  FreeBSD|OpenBSD|DragonFly) REPLY=$icons[FREEBSD_ICON];;
  Linux)
    local os_release_id
    if [[ -r /etc/os-release ]]; then
      local lines=(${(f)"$(</etc/os-release)"})
      lines=(${(@M)lines:#ID=*})
      (( $#lines == 1 )) && os_release_id=${lines[1]#ID=}
    elif [[ -e /etc/artix-release ]]; then
      os_release_id=artix
    fi
    case $os_release_id in
      *arch*)                  REPLY=$icons[LINUX_ARCH_ICON];;
      *debian*)
            if [[ -f /etc/apt/sources.list.d/raspi.list ]]; then
              REPLY=$icons[LINUX_RASPBIAN_ICON]
            else
              REPLY=$icons[LINUX_DEBIAN_ICON]
            fi
            ;;
      *raspbian*)              REPLY=$icons[LINUX_RASPBIAN_ICON];;
      *ubuntu*)                REPLY=$icons[LINUX_UBUNTU_ICON];;
      *elementary*)            REPLY=$icons[LINUX_ELEMENTARY_ICON];;
      *fedora*)                REPLY=$icons[LINUX_FEDORA_ICON];;
      *coreos*)                REPLY=$icons[LINUX_COREOS_ICON];;
      *gentoo*)                REPLY=$icons[LINUX_GENTOO_ICON];;
      *mageia*)                REPLY=$icons[LINUX_MAGEIA_ICON];;
      *centos*)                REPLY=$icons[LINUX_CENTOS_ICON];;
      *opensuse*|*tumbleweed*) REPLY=$icons[LINUX_OPENSUSE_ICON];;
      *sabayon*)               REPLY=$icons[LINUX_SABAYON_ICON];;
      *slackware*)             REPLY=$icons[LINUX_SLACKWARE_ICON];;
      *linuxmint*)             REPLY=$icons[LINUX_MINT_ICON];;
      *alpine*)                REPLY=$icons[LINUX_ALPINE_ICON];;
      *aosc*)                  REPLY=$icons[LINUX_AOSC_ICON];;
      *nixos*)                 REPLY=$icons[LINUX_NIXOS_ICON];;
      *devuan*)                REPLY=$icons[LINUX_DEVUAN_ICON];;
      *manjaro*)               REPLY=$icons[LINUX_MANJARO_ICON];;
      *void*)                  REPLY=$icons[LINUX_VOID_ICON];;
      *artix*)                 REPLY=$icons[LINUX_ARTIX_ICON];;
      *rhel*)                  REPLY=$icons[LINUX_RHEL_ICON];;
      amzn)                    REPLY=$icons[LINUX_AMZN_ICON];;
      endeavouros)             REPLY=$icons[LINUX_ENDEAVOUROS_ICON];;
      *)                       REPLY=$icons[LINUX_ICON];;
    esac
  ;;
esac
REPLY="$(print -P $REPLY) "
