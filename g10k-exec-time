  (( __exec_timestamp )) || return
  local -i exec_duration=$(( SECONDS - __exec_timestamp ))
  __exec_timestamp=0
  local -i reporttime=${G10K_REPORTTIME:-${REPORTTIME:-5}}
  (( reporttime >= 0 )) || return
  (( exec_duration >= reporttime )) || return
  REPLY="$(( exec_duration % 60 ))s"
  if (( exec_duration >= 60 )); then
    REPLY="$(( exec_duration / 60 % 60 ))m $REPLY"
    if (( exec_duration >= 3600 )); then
      REPLY="$(( exec_duration / 3600 % 24 ))h $REPLY"
      if (( exec_duration >= 86400 )); then
        REPLY="$(( d / 86400 ))d $REPLY"
      fi
    fi
  fi
  REPLY="  $REPLY"
